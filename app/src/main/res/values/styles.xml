<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.MotoRider.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.MotoRider.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">10dp</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="Widget.MotoRider.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.MotoRider.Button.MapAction" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Widget.MotoRider.Button.PlanRoute" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.MotoRider.Card.Dialog" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">6dp</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="Theme.MotoRider.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowElevation">8dp</item>
    </style>

</resources>
