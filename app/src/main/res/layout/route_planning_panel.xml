<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============================================================ -->
        <!-- Top bar: Curvature, Avoidances, More                         -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_curvature"
                style="@style/Widget.MotoRider.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/curvature"
                app:icon="@drawable/ic_curvature"
                app:iconGravity="textStart"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_avoidances"
                style="@style/Widget.MotoRider.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/avoidances"
                app:icon="@drawable/ic_avoidances"
                app:iconGravity="textStart"
                app:iconSize="16dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_more_options"
                style="@style/Widget.MotoRider.Button.Icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:icon="@drawable/ic_more_vert"
                app:iconSize="20dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_200"
            android:layout_marginVertical="12dp" />

        <!-- ============================================================ -->
        <!-- Start Waypoint                                                -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/start_location_bg"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/start_location_hint"
                    android:src="@drawable/ic_home"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/et_start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:hint="@string/start_location_hint"
                    android:inputType="text"
                    android:lines="1"
                    android:maxLines="1" />

                <ImageButton
                    android:id="@+id/btn_set_start"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/set_start_location"
                    android:src="@drawable/ic_set_location"
                    app:tint="@color/primary" />

                <ImageButton
                    android:id="@+id/btn_remove_start"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/remove"
                    android:src="@drawable/ic_close"
                    app:tint="@color/gray_600" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- Intermediate waypoints (added dynamically)                    -->
        <!-- ============================================================ -->
        <LinearLayout
            android:id="@+id/intermediate_waypoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ============================================================ -->
        <!-- Dotted connector between start and end                       -->
        <!-- ============================================================ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="2dp">

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/dotted_line" />

        </FrameLayout>

        <!-- ============================================================ -->
        <!-- End Waypoint                                                  -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/end_location_bg"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/end_location_hint"
                    android:src="@drawable/ic_flag"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/et_end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:hint="@string/end_location_hint"
                    android:inputType="text"
                    android:lines="1"
                    android:maxLines="1" />

                <ImageButton
                    android:id="@+id/btn_set_end"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/set_end_location"
                    android:src="@drawable/ic_set_location"
                    app:tint="@color/error" />

                <ImageButton
                    android:id="@+id/btn_remove_end"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/remove"
                    android:src="@drawable/ic_close"
                    app:tint="@color/gray_600" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- Vehicule type selector + Add waypoint                        -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehicle"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/on_surface_variant"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btn_motorcycle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/motorcycle"
                android:padding="8dp"
                android:src="@drawable/ic_motorcycle"
                app:tint="@color/primary" />

            <ImageButton
                android:id="@+id/btn_truck"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/truck"
                android:padding="8dp"
                android:src="@drawable/ic_truck"
                app:tint="@color/gray_600"
                android:layout_marginStart="4dp" />

            <ImageButton
                android:id="@+id/btn_car"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/car"
                android:padding="8dp"
                android:src="@drawable/ic_car"
                app:tint="@color/gray_600"
                android:layout_marginStart="4dp" />

            <ImageButton
                android:id="@+id/btn_bike"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bike"
                android:padding="8dp"
                android:src="@drawable/ic_bike"
                app:tint="@color/gray_600"
                android:layout_marginStart="4dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_waypoint"
                style="@style/Widget.MotoRider.Button.Icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/add_waypoint"
                app:icon="@drawable/ic_add"
                app:iconSize="20dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_200"
            android:layout_marginVertical="12dp" />

        <!-- ============================================================ -->
        <!-- Plan Route Button                                             -->
        <!-- ============================================================ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_plan_route"
            style="@style/Widget.MotoRider.Button.PlanRoute"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/plan_route_button"
            app:icon="@drawable/ic_set_location"
            app:iconGravity="textStart"
            app:iconSize="20dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
