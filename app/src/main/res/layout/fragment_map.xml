<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/mapview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_navigation"
            style="@style/Widget.MotoRider.Button.MapAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_navigation"
            app:icon="@drawable/ic_motorcycle"
            app:iconGravity="textStart"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_plan_route"
            style="@style/Widget.MotoRider.Button.MapAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/plan_route"
            app:icon="@drawable/ic_set_location"
            app:iconGravity="textStart"
            app:iconSize="18dp" />

    </LinearLayout>

</FrameLayout>
